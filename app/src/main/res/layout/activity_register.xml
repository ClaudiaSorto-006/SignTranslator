<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TopAppBar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/surface"
            android:elevation="2dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical">

            <!-- Avatar / Icono usuario -->
            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_primary_container">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_account_circle"
                    app:tint="@color/on_primary_container"
                    android:contentDescription="Perfil" />

            </FrameLayout>

            <!-- Título centrado -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SignTranslation"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="@font/atkinson_hyperlegible" />

            <!-- Botón ayuda -->
            <ImageButton
                android:id="@+id/btnHelp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ayuda"
                android:src="@drawable/ic_help_outline"
                app:tint="@color/primary" />

        </LinearLayout>

        <!-- Contenido principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="40dp">

            <!-- Título "Crear cuenta" -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crear cuenta"
                android:textColor="@color/on_background"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="@font/atkinson_hyperlegible"
                android:layout_marginBottom="8dp" />

            <!-- Subtítulo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Únete a la comunidad de SignTranslation y rompe las barreras de comunicación."
                android:textColor="@color/on_surface_variant"
                android:textSize="15sp"
                android:gravity="center"
                android:fontFamily="@font/atkinson_hyperlegible"
                android:layout_marginBottom="28dp" />

            <!-- Card del formulario -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Label: Nombre -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nombre completo"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/atkinson_hyperlegible"
                        android:layout_marginBottom="6dp" />

                    <!-- Campo: Nombre -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:boxStrokeColor="@color/outline"
                        app:boxStrokeWidth="1dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="Ej. Juan Pérez"
                            android:inputType="textPersonName|textCapWords"
                            android:textSize="15sp"
                            android:fontFamily="@font/atkinson_hyperlegible"
                            android:imeOptions="actionNext" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Label: Correo -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Correo electrónico"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/atkinson_hyperlegible"
                        android:layout_marginBottom="6dp" />

                    <!-- Campo: Correo -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:boxStrokeColor="@color/outline"
                        app:boxStrokeWidth="1dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="nombre@ejemplo.com"
                            android:inputType="textEmailAddress"
                            android:textSize="15sp"
                            android:fontFamily="@font/atkinson_hyperlegible"
                            android:imeOptions="actionNext" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Label: Contraseña -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Contraseña"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/atkinson_hyperlegible"
                        android:layout_marginBottom="6dp" />

                    <!-- Campo: Contraseña -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/outline"
                        app:boxStrokeColor="@color/outline"
                        app:boxStrokeWidth="1dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="••••••••"
                            android:inputType="textPassword"
                            android:textSize="15sp"
                            android:fontFamily="@font/atkinson_hyperlegible"
                            android:imeOptions="actionDone" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Botón Registrarse (full rounded) -->
                    <Button
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Registrarse"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/atkinson_hyperlegible"
                        android:backgroundTint="@color/primary"
                        android:textColor="@color/on_primary"
                        app:cornerRadius="28dp"
                        android:layout_marginBottom="20dp" />

                    <!-- ¿Ya tienes cuenta? -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¿Ya tienes una cuenta?"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="15sp"
                            android:fontFamily="@font/atkinson_hyperlegible" />

                        <TextView
                            android:id="@+id/tvLogin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" Inicia sesión"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/atkinson_hyperlegible"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground" />

                    </LinearLayout>

                    <!-- Divisor "O regístrate con" -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/outline_variant" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="O regístrate con"
                            android:textColor="@color/outline"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/atkinson_hyperlegible"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/outline_variant" />

                    </LinearLayout>

                    <!-- Botón Google -->
                    <Button
                        android:id="@+id/btnGoogle"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Google"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:fontFamily="@font/atkinson_hyperlegible"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/outline_variant"
                        app:icon="@drawable/ic_google"
                        app:iconGravity="textStart"
                        app:iconTint="@null" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Nota de accesibilidad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_accessibility_note"
                android:padding="16dp"
                android:gravity="top">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_visibility"
                    app:tint="@color/secondary"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Accesibilidad" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Esta pantalla es compatible con lectores de pantalla y navegación por gestos para garantizar una experiencia inclusiva."
                    android:textColor="@color/secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/atkinson_hyperlegible" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>