<?xml version="1.0" encoding="utf-8"?>
<!--
    Coloca este archivo en: res/font/atkinson_hyperlegible.xml

    IMPORTANTE: También debes descargar los archivos .ttf de la fuente desde:
    https://fonts.google.com/specimen/Atkinson+Hyperlegible+Next

    Archivos necesarios (colócalos en res/font/):
      - atkinson_hyperlegible_regular.ttf
      - atkinson_hyperlegible_bold.ttf

    O puedes usar la descarga automática de Google Fonts agregando en AndroidManifest.xml
    dentro de <application>:

    <meta-data
        android:name="preloaded_fonts"
        android:resource="@array/preloaded_fonts" />

    Y en res/values/preloaded_fonts.xml:
    <resources>
        <array name="preloaded_fonts" translatable="false">
            <item>@font/atkinson_hyperlegible</item>
        </array>
    </resources>
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Regular -->
    <font
        android:font="@font/atkinson_hyperlegible_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/atkinson_hyperlegible_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <!-- Bold -->
    <font
        android:font="@font/atkinson_hyperlegible_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/atkinson_hyperlegible_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

</font-family>